# .env.example - Copy this to .env and fill in your values

# Supabase (for auth only)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# PostgreSQL Database
# For Vercel Postgres, Neon, Supabase Postgres, or any PostgreSQL provider
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://username:password@host:5432/database?sslmode=require"

# API Server Configuration
API_PORT=3001
NODE_ENV=development

# Frontend API URL (for production, set to your deployed API URL)
# VITE_API_URL=https://api.yourdomain.com/api
