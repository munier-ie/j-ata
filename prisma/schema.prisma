// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============= ENUMS =============

enum AppRole {
  admin
  moderator
  user
  startup
  investor
  mentor
}

enum FacilityStatus {
  planned
  under_construction
  operational
  rehabilitated
}

enum FacilityType {
  innovation_hub
  service_center
  farm_estate
}

// ============= MODELS =============

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      AppRole  @default(user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile               Profile?
  startup               Startup?
  incubatorApplications IncubatorApplication[]
  mentorProfile         MentorProfile?
  investorProfile       InvestorProfile?

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ManagementMember {
  id             String   @id @default(uuid())
  name           String
  role           String
  imageUrl       String?  @map("image_url")
  bio            String
  isCommissioner Boolean  @default(false) @map("is_commissioner")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("management_members")
}

model Farmer {
  id        String   @id @default(uuid())
  farmerId  String   @unique @map("farmer_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String
  nin       String?
  lga       String
  ward      String
  community String
  farmSize  Float    @default(0) @map("farm_size")
  cropTypes String @map("crop_types")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batches   ProductBatch[]

  @@map("farmers")
}

model FarmEstate {
  id                   String         @id @default(uuid())
  name                 String
  lga                  String
  zone                 String?
  address              String?
  latitude             Float?
  longitude            Float?
  totalHectares        Float?         @map("total_hectares")
  status               FacilityStatus @default(planned)
  completionPercentage Int?           @map("completion_percentage")
  budgetAllocated      Float?         @map("budget_allocated")
  budgetSpent          Float?         @map("budget_spent")
  hasWater             Boolean?       @map("has_water")
  hasPower             Boolean?       @map("has_power")
  hasAccessRoad        Boolean?       @map("has_access_road")
  hasStorageFacility   Boolean?       @map("has_storage_facility")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@map("farm_estates")
}

model InnovationHub {
  id                   String         @id @default(uuid())
  name                 String
  facilityType         FacilityType   @map("facility_type")
  lga                  String
  zone                 String?
  address              String?
  latitude             Float?
  longitude            Float?
  capacity             Int?
  status               FacilityStatus @default(planned)
  completionPercentage Int?           @map("completion_percentage")
  budgetAllocated      Float?         @map("budget_allocated")
  budgetSpent          Float?         @map("budget_spent")
  hasWater             Boolean?       @map("has_water")
  hasPower             Boolean?       @map("has_power")
  services             String
  contactPhone         String?        @map("contact_phone")
  contactEmail         String?        @map("contact_email")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@map("innovation_hubs")
}

model NewsArticle {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  imageUrl    String?   @map("image_url")
  category    String
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("news_articles")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("general")
  fileUrl     String?  @map("file_url")
  isPublished Boolean  @default(false) @map("is_published")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("reports")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

// ============= NEW MODULES =============

// --- Incubation ---

model Startup {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  name        String
  description String?
  sector      String?  // e.g., AgTech, Processing, Logistics
  stage       String   @default("ideation") // ideation, mvp, scaling
  cohort      String?  // e.g., 2026 Cohort
  status      String   @default("pending") // pending, active, graduated
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GrantMilestone[]
  mentorships MentorshipSession[]

  @@map("startups")
}

model IncubatorApplication {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  answers   Json     // Store application questions and answers
  status    String   @default("pending") // pending, shortlisted, rejected, accepted
  score     Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("incubator_applications")
}

model GrantMilestone {
  id          String   @id @default(uuid())
  startupId   String   @map("startup_id")
  title       String
  description String?
  amount      Float
  status      String   @default("pending") // pending, verified, paid
  proofUrl    String?  @map("proof_url")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("grant_milestones")
}

model MentorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  expertise   String // e.g., ["Agronomy", "Marketing"]
  bio         String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions MentorshipSession[]

  @@map("mentor_profiles")
}

model MentorshipSession {
  id          String   @id @default(uuid())
  startupId   String   @map("startup_id")
  mentorId    String   @map("mentor_id")
  topic       String?
  scheduledAt DateTime @map("scheduled_at")
  status      String   @default("scheduled") // scheduled, completed, cancelled
  createdAt   DateTime @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  mentor  MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentorship_sessions")
}

// --- Investment ---

model InvestmentProject {
  id          String   @id @default(uuid())
  title       String
  description String
  lga         String
  sector      String
  fundingGoal Float    @map("funding_goal")
  expectedRoi String?  @map("expected_roi")
  riskLevel   String?  @map("risk_level")
  status      String   @default("open") // open, closed, fully_funded
  documents   String // URLs to PDFs
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("investment_projects")
}

model InvestorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String?  @map("company_name")
  country     String?
  focusSectors String @map("focus_sectors")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

// --- Export & Traceability ---

model ProductBatch {
  id          String   @id @default(uuid())
  farmerId    String?  @map("farmer_id") // Optional link to registered farmer
  commodity   String   // Sesame, Hibiscus, Gum Arabic
  weight      Float    // In KG
  grade       String?  // A, B, C
  originLga   String   @map("origin_lga")
  status      String   @default("collected") // collected, processed, stored, exported
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  farmer Farmer? @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  logs   TraceabilityLog[]
  certificates QualityCertificate[]

  @@map("product_batches")
}

model QualityCertificate {
  id          String   @id @default(uuid())
  batchId     String   @map("batch_id")
  certType    String   @map("cert_type") // e.g., Phytosanitary, Purity
  issuer      String
  issueDate   DateTime @map("issue_date")
  resultData  Json?    @map("result_data") // Detailed test results
  fileUrl     String?  @map("file_url")
  createdAt   DateTime @default(now()) @map("created_at")

  batch ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("quality_certificates")
}

model TraceabilityLog {
  id          String   @id @default(uuid())
  batchId     String   @map("batch_id")
  action      String   // harvested, processed, stored, shipped
  location    String
  operatorId  String?  @map("operator_id") // Who performed the action
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  batch ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("traceability_logs")
}

model PppApplication {
  id                String   @id @default(uuid())
  companyName       String   @map("company_name")
  contactPerson     String   @map("contact_person")
  email             String
  phone             String
  selectedProject   String   @map("selected_project")
  proposedInvestment String  @map("proposed_investment")
  expectedRoi       String   @map("expected_roi")
  status            String   @default("pending") // pending, approved, rejected
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("ppp_applications")
}

model InvestmentOpportunity {
  id                String   @id @default(uuid())
  title             String
  description       String
  sector            String
  location          String
  requiredFunding   Float    @map("required_funding")
  expectedRoi       String   @map("expected_roi")
  status            String   @default("open") // open, funded, closed
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("investment_opportunities")
}

model ProjectPipeline {
  id                String   @id @default(uuid())
  projectName       String   @map("project_name")
  description       String?
  stage             String   @default("planning") // planning, design, construction, operational
  progress          Int      @default(0) // Percentage
  budgetAllocated   Float?   @map("budget_allocated")
  budgetSpent       Float?   @map("budget_spent")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("project_pipelines")
}

model Warehouse {
  id                String   @id @default(uuid())
  name              String
  location          String
  capacity          Float?   // in tons
  currentStock      Float?   @map("current_stock") // in tons
  commodityType     String?  @map("commodity_type") // Hibiscus, Sesame, etc.
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}
